          "name": "Senders can add encrypted messages",
          "as": "PERMISSIVE",
          "for": "INSERT",
          "to": [
            "authenticated"
          ],
          "withCheck": "((auth.uid() = sender_id) AND (EXISTS ( SELECT 1\n   FROM messaging_conversations c\n  WHERE ((c.id = messaging_messages.conversation_id) AND ((auth.uid() = c.user_a) OR (auth.uid() = c.user_b)) AND ((messaging_messages.recipient_id = c.user_a) OR (messaging_messages.recipient_id = c.user_b)) AND (messaging_messages.sender_id <> messaging_messages.recipient_id)))))"
        },
